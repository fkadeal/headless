        {
          "name": "Get Posts",
          "id": "get-posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Get all posts"
          },
          "response": []
        },
        {
          "name": "Get Posts with Filters",
          "id": "get-posts-filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?filters[status][eq]=published&filters[views][gt]=1000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                {
                  "key": "filters[status][eq]",
                  "value": "published"
                },
                {
                  "key": "filters[views][gt]",
                  "value": "1000"
                }
              ]
            },
            "description": "Get posts with advanced filtering"
          },
          "response": []
        },
